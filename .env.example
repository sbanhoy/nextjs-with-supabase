# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# AI soạn tin (/message): điền 1 trong 2, GROQ_API_KEY được ưu tiên.
# Trên Vercel: Settings > Environment Variables, chọn cả Production/Preview/Development.
# KHÔNG commit giá trị thật vào repo.
GROQ_API_KEY=
OPENAI_API_KEY=
# Tuỳ chọn: đổi model Groq (mặc định openai/gpt-oss-120b)
# GROQ_MODEL=
